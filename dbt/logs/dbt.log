[0m20:28:20.494565 [debug] [Thread-2 (]: On model.lumora.int_month_spine: create or replace   view LUMORA.INTERMEDIATE.int_month_spine
  
  
  
  
  as (
    -- One row per calendar month in the analysis window (vars in dbt_project.yml).
with spine as (
    





with rawdata as (

    

    

    with p as (
        select 0 as generated_number union all select 1
    ), unioned as (

    select

    
    p0.generated_number * power(2, 0)
     + 
    
    p1.generated_number * power(2, 1)
     + 
    
    p2.generated_number * power(2, 2)
     + 
    
    p3.generated_number * power(2, 3)
     + 
    
    p4.generated_number * power(2, 4)
     + 
    
    p5.generated_number * power(2, 5)
    
    
    + 1
    as generated_number

    from

    
    p as p0
     cross join 
    
    p as p1
     cross join 
    
    p as p2
     cross join 
    
    p as p3
     cross join 
    
    p as p4
     cross join 
    
    p as p5
    
    

    )

    select *
    from unioned
    where generated_number <= 36
    order by generated_number



),

all_periods as (

    select (
        

    dateadd(
        month,
        row_number() over (order by generated_number) - 1,
        cast('2023-01-01' as date)
        )


    ) as date_month
    from rawdata

),

filtered as (

    select *
    from all_periods
    where date_month <= cast('2026-01-01' as date)

)

select * from filtered


)

select
    cast(date_month as date)                         as month_start,
    cast(cast(
        

    dateadd(
        day,
        -1,
        

    dateadd(
        month,
        1,
        date_trunc('month', date_month)
        )


        )


        as date) as date) as month_end
from spine
  )
